generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Lead {
  id String @id @default(cuid())

  neoDoveLeadId String? @unique

  fullName String
  phone    String?
  email    String?

  type LeadType @default(ADMISSION)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  courseSlug String?
  courseName String?

  subject String?
  message String?

  source LeadSource @default(WEBSITE)
  status LeadStatus @default(NEW)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(cuid())

  name String
  slug String @unique

  neoDoveCampaignId String? @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model Admin {
  id String @id @default(cuid())

  fullName String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadType {
  ADMISSION
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum LeadSource {
  WEBSITE
  GOOGLE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  NEODOVE
}

model PlacementApplication {
  id String @id @default(cuid())

  fullName String
  email    String
  phone    String

  courseSlug String?
  courseName String?

  resumeUrl  String?
  resumeName String?

  status PlacementApplicationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlacementApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}