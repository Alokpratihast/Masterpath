generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
// LEAD
// =========================

model Lead {
  id String @id @default(cuid())

  neoDoveLeadId String? @unique

  fullName String
  phone    String?
  email    String?

  type LeadType @default(ADMISSION)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  courseSlug String?
  courseName String?

  subject String?
  message String?

  source LeadSource @default(WEBSITE)
  status LeadStatus @default(NEW)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// CAMPAIGN
// =========================

model Campaign {
  id String @id @default(cuid())

  name String
  slug String @unique

  neoDoveCampaignId String? @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

// =========================
// ADMIN
// =========================

model Admin {
  id String @id @default(cuid())

  fullName String
  email    String @unique
  password String

  blogs Blog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// LEAD ENUMS
// =========================

enum LeadType {
  ADMISSION
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum LeadSource {
  WEBSITE
  GOOGLE
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  NEODOVE
}

// =========================
// PLACEMENT APPLICATION
// =========================

model PlacementApplication {
  id String @id @default(cuid())

  fullName String
  email    String
  phone    String

  courseSlug String?
  courseName String?

  resumeUrl  String?
  resumeName String?

  status PlacementApplicationStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PlacementApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

// =========================
// BLOG
// =========================

model Blog {
  id String @id @default(cuid())

  // CONTENT

  title String

  slug String @unique

  excerpt String? @db.Text

  content String @db.LongText

  // IMAGEKIT

  featuredImage String?

  featuredImageAlt String?

  ogImage String?

  // AUTHOR

  authorId String?

  author Admin? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // CATEGORY

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // PUBLISHING

  status BlogStatus @default(DRAFT)

  publishedAt DateTime?

  // SEO

  seoTitle String?

  seoDescription String? @db.Text

  focusKeyword String?

  canonicalUrl String?

  noIndex Boolean @default(false)

  noFollow Boolean @default(false)

  // TAGS

  tags BlogTag[]

  // TIMESTAMPS

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // INDEXES

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt])
  @@index([createdAt])
}

// =========================
// BLOG CATEGORY
// =========================

model Category {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String? @db.Text

  blogs Blog[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// =========================
// BLOG TAG
// =========================

model Tag {
  id String @id @default(cuid())

  name String

  slug String @unique

  blogs BlogTag[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

// =========================
// BLOG ↔ TAG
// =========================

model BlogTag {
  blogId String

  tagId String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId])
}

// =========================
// BLOG STATUS
// =========================

enum BlogStatus {
  DRAFT
  PUBLISHED
}
